        height: 54px;
        object-fit: contain;
      }
    }

    .product-plan-content {
      height: 197px;
      padding: 16px;
      box-sizing: border-box;
      border-radius: 10px;
      background: #fff;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .plan-info {
      min-height: 0;
      overflow: hidden;

      .plan-item {
        color: #19191a;
        font-size: 12px;
        font-weight: 400;
        line-height: 22px;
      }

      .history-download {
        color: #6669ff;
        display: flex;
        align-self: flex-start;
        align-items: center;
        font-weight: 500;

        .history-download-icon {
          flex: none;

          path {
            fill: currentColor;
          }
        }
      }

      .more-plan {
        color: #19191a;
      }
    }

    &.org_ai_point {
      .plan-item-group {
        flex-direction: column;
        align-items: flex-start;
        gap: 1px;

        > div:first-child {
          display: flex;
        }

        .plan-item {
          display: inline;
        }
      }
    }

    .bottom-container {
      position: static;
      height: 28px;
      min-height: 28px;
      margin-top: auto;
      padding-top: 12px;
      box-sizing: border-box;
      border-top: 1px solid rgba(18, 17, 42, 0.07);

      .seat-info {
        color: #19191a;
        font-size: 12px;
        font-weight: 400;
        line-height: 17px;
      }
    }

    .upgrade-btn {
      height: 28px;
      padding: 6px 6px 6px 8px;
      gap: 2px;
      border-radius: 6px;
      color: var(--product-plan-accent);
      background: var(--product-plan-button-bg);
      font-size: 12px;
      font-weight: 500;
      line-height: 16px;

      .upgrade-arrow {
        width: 12px;
        height: 12px;

        path {
          fill: currentColor;
        }
      }
    }
  }
