  .wide-tooltip-trigger + .ant-tooltip .ant-tooltip-inner {
    max-width: none !important;
    width: 700px !important;
  }

  /*************************
   * Disable tooltips on mobile & tablet
   *************************/
  ${e=>e.theme.isMobile&&!e.theme.isEmbeded&&!e.theme.isSidePanelMode&&(0,a.AH)`
      .ant-tooltip {
        display: none !important;
      }
    `}
  ${e=>e.theme.isTablet&&!e.theme.isSidePanelMode&&(0,a.AH)`
      .ant-tooltip {
        display: none !important;
      }
    `}

  .ant-tooltip:has(.action-text-tooltip){
    max-width: none;
    .action-text-tooltip{
      max-width: 700px;
    }
  }
  /*******end********/

  /*****antd notification*******/
  .ant-notification .ant-notification-notice-wrapper {
    border-radius: 16px;
    .ant-notification-notice-with-icon {
      .ant-notification-notice-message {
        color: var(--color-text-1);
        font-weight: 600;
        font-size: 16px;
        margin-inline-start: 56px;
      }
      .ant-notification-notice-description {
        margin-inline-start: 56px;
        color: var(--color-text-3);
      }
    }
  }
  .dark-message {
    .ant-message-notice-content {
      background-color: var(--color_bg_tips) !important;
      color: var(--color-text-5);
      padding: 8px 16px !important;
    }
  }
  .ant-message {
    .no-icon-message {
      .ant-message-notice-content {
        padding: 10px 20px 10px 16px;

        .anticon {
          display: none;
        }
      }
    }
    .custom-error-message {
      .ant-message-notice-content {
        height: 44px;
        background-color: var(--color-danger-6);
        font-size: 16px;
        font-style: normal;
        font-weight: 500;
        color: var(--color-text-5);

        .close-icon {
          path {
            fill: var(--color-text-5);
          }
        }
      }
    }
  }

  /*******end*******/

  /*****ReactMarkdown 增加table默认样式*****/
  .markdown-body table {
    border-collapse: collapse;
    margin: 1em 0;
    th,td{
      border: 1px solid #ddd;
      padding: 8px 12px;
      text-align: left;
    }
    th{
      background-color: #f8f8f8;
    }
  }
  /*******end*******/

  :root[data-theme='dark'] .panel-content .content .markdown-content,
  :root[data-theme='dark'] .setting-main .content .markdown-content,
  :root[data-theme='dark'] .msg-wrapper .markdown-body {
    color: #19191A;
    background-color: #FFFFFF;
  }

  :root[data-theme='dark'] .panel-content .content .ai-mark-tag,
  :root[data-theme='dark'] .msg-wrapper:has(.markdown-body) .ai-mark-tag {
    color: #B7B9BD;
    background-color: #FFFFFF;
    border-color: #ECEEF2;
  }

  /* markdown-body 增加tailwindcss样式，适配streamdown组件 */
  .markdown-body [data-streamdown='strong'] {
    font-weight: 600;
  }

  .markdown-body .language-mermaid {
    margin: 0 3rem;
    border: 1px solid #ddd;
    border-radius: calc(.625rem - 2px);
    &.p-4 {
      padding: 4px;
    }
    .p-1 {
      padding: calc(.25rem * 1);
    }
    .overflow-hidden {
      overflow: hidden;
    }
    .relative {
      position: relative;
    }
    .absolute {
      position: absolute;
    }
    .left-2 {
      left: calc(.25rem * 2);
    }
    .bottom-2 {
      bottom: calc(.25rem * 2);
    }
    .border {
      border: 1px solid #ddd;
    }
    .shadow-sm {
      box-shadow: 0 1px 3px 0 var(--color-box-shadow), 0 1px 2px -1px var(--color-box-shadow);
    }
    .rounded-md {
      background-color: color-mix(in oklab, #fff 90%, transparent);
      border-radius: calc(.625rem - 2px);
    }
    .flex {
      display: flex;
    }
    .justify-center {
      justify-content: center;
    }
    .items-center {
      align-items: center;
    }
    .flex-col {
      flex-direction: column;
    }
    .gap-1 {
      gap: .25rem;
    }
    .z-10 {
      z-index: 10;
    }
    button:not(:disabled) {
      padding: calc(.25rem * 1.5);
      border: #fff;
      border-radius: .25rem;
      background-color: #fff;
      cursor: pointer;

      &:hover {
        background-color: #ddd;
      }
    }
    .p-1\.5 {

    }
  }
  /* end */

  /****** download apps popover ******/
  .download-apps-popover {
    .ant-popover-inner {
      background-color: var(--color-fill-bg);
      border: 1px solid var(--color-border-1);
      border-radius: 16px;
      box-shadow: 0px 4px 6px -2px var(--color-box-shadow), 0px 12px 16px -4px var(--color-box-shadow);
      padding: 0;
    }

    .ant-popover-inner-content {
      padding: 0;
    }

    .ant-popover-arrow {
      display: none;
    }

    .download-apps-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 20px;
      min-width: 200px;

      .qr-codes {
        display: flex;
        gap: 24px;
        align-items: stretch;
        width: 100%;

        .qr-code-item {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 8px;

          .qr-code-image {
            width: 120px;
            height: 120px;
            object-fit: cover;
            background: #fff;
          }
        }
      }

      .download-text {
        font-size: 14px;
        color: #8B8C8F;
        text-align: center;
        line-height: 1.4;
      }
    }
  }
  /******* end ********/

  /******* Monaco editorCode ********/
  .monaco-editor{
    .scrollbar{
      width: 4px!important;
      height: 4px!important;
      border-radius:10px;
    }
    .margin-view-overlays{
      .line-numbers{
        min-width: 34px;
        width: fit-content!important;
        white-space: nowrap;
      }
    }
    .lines-content .core-guide-indent{
      &.vertical[class*="lvl-"] {
          --indent-color: var(--color-lvl-line);
          --indent-color-active: #939393;
      }
    }
    .monaco-mouse-cursor-text{
      .mtk4 { color:var(--color-mtk4-font) !important; }
      .mtk6 { color: var(--color-mtk6-font) !important; }
      .mtk18 { color: var(--color-mtk18-font) !important; }
      .mtk29 { color: var(--color-mtk29-font) !important; }
      .mtki { font-style: italic; }
      .mtkb { font-weight: bold; }
      .mtku { text-decoration: underline; text-underline-position: under; }
      .mtks { text-decoration: line-through; }
      .mtks.mtku { text-decoration: underline line-through; text-underline-position: under; }
    }
  }
