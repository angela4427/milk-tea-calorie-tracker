      display: flex;
      justify-content: center;
      align-items: center;
    }

    .ReactCrop__crop-selection:not(.ReactCrop--no-animate .ReactCrop__crop-selection) {
      background-image: 
        linear-gradient(to right, #fff 50%, var(--brand-500, #6669FF) 50%), 
        linear-gradient(to right, #fff 50%, var(--brand-500, #6669FF) 50%), 
        linear-gradient(#fff 50%, var(--brand-500, #6669FF) 50%), 
        linear-gradient(#fff 50%, var(--brand-500, #6669FF) 50%);
