      .btn-back {
        visibility: hidden;
        transition: all 0s;
      }

      .ppt-presentation-thumbnail {
        width: 180px;
        height: 100px;
      }
    }
  }

  &.collapse.is-hover-open {
    position: relative;
    /* 高于 ContentLoading(z-index:100)，避免收起态浮层叠在内容区时被 loading 遮住 */
    z-index: 200;
    overflow: visible;
    .list {
      position: absolute;
      height: calc(100% - 66px);
      top: 58px;
      left: 8px;
      padding: 8px;
      width: 240px;
      border-radius: 12px;
      border: 1px solid var(--color-border-1, #ECEEF2);
      background: var(--color-fill-bg, #FFF);
      box-shadow: 0 6px 20px 0 rgba(25, 25, 26, 0.06), 0 2px 12px 0 rgba(25, 25, 26, 0.04);
      z-index: 200;

      .list-title {
        display: flex;
      }

      .btn-back {
        visibility: visible;
      }
      .file-tree,
      .ppt-presentation-catalog {
        flex: 1;
        min-height: 0;
      }
    }

    .toggle-icon {
      background-color: var(--color-fill-clk);
    }
  }

  .title,
  .list-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-1);
    user-select: none;
    height: 46px;
    display: flex;
    align-items: center;
    padding: 0 8px 0 16px;
    justify-content: space-between;
    white-space: nowrap;

    .ant-btn {
      width: 30px;
      height: 30px;
      flex-shrink: 0;

      svg {
        transform: rotate(180deg);
      }
    }
  }

  &.collapse, &.collapse.is-hover-open {
    .title .ant-btn svg {
      transform: rotate(0deg);
    }
  }

  .list-title {
    height: 38px;
    padding: 0 8px;
    margin-bottom: 8px;
    display: none;
  }
  

  .list {
    height: calc(100% - 46px);
    display: flex;
    flex-direction: column;
    padding: 8px;
    box-sizing: border-box;
    overflow: hidden;

    .btn-back {
      width: 100%;
      margin: 0 0 8px;
      height: 28px;
      gap: 2px;
      padding: 0 4px 0 0;
      white-space: nowrap;
      svg {
        transform: rotate(-90deg);
      }
    }
    .group-name {
      color: var(--color-text-3);
      padding: 7px 8px;
      font-weight: 500;
    }
  }

  .file-item {
    display: flex;
    align-items: center;
    padding: 6px 8px;
    height: 32px;
    border-radius: 8px;
    margin-bottom: 6px;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    color: var(--color-text-2);

    &:hover,
    &.active {
      background: var(--color-fill-hov);
    }

    .name {
      margin-left: 6px;
      width: calc(100% - 22px);
      user-select: none;
    }

    .setting-label {
      font-weight: 500;
      color: var(--color-text-1);
      span {
        color: var(--color-text-3);
        font-weight: 400;
        font-size: 12px;
        margin-left: 2px;
      }
    }

    svg {
      & > * {
        fill: currentColor;
      }
    }
  }

  .ppt-presentation-catalog {
    flex: 1;

    .ppt-presentation-catalog-list {
      margin: 0 -8px;
      padding: 0 8px;
      padding-top: 12px;
    }
  }

  .file-tree {
    /* 子树有返回按钮/组名时，用 flex 占满剩余高度，避免 height:100% 被裁切导致无法滚动 */
    flex: 1;
    min-height: 0;
    height: auto;
    overflow: auto;
    margin: 0 -8px;
    padding: 0 8px;
    box-sizing: border-box;
    .ant-tree {
      background: transparent;
      font-size: 13px;
      line-height: 22px;
    }

    .ant-tree-list-holder-inner {
      gap: 6px;
    }

    :not(:has(.tree-switcher-icon-wrap)) {
      .ant-tree-switcher {
        width: 0;
      }
    }

    .ant-tree-treenode {
      padding: 0;
      margin: 0;
      align-items: stretch;
      border-radius: 8px;
      transition: background-color 0.15s ease;

      &::before {
        display: none;
      }

      &.ant-tree-treenode-leaf {
        .ant-tree-node-content-wrapper {
          padding-left: 8px;
        }
      }

      &.ant-tree-treenode-disabled {
        .ant-tree-node-content-wrapper {
          cursor: default;

          &:hover {
            background-color: transparent;
          }
        }
      }

      &.ant-tree-treenode-selected,
      &:hover {
        background: var(--color-fill-hov);
      }

      .ant-tree-node-content-wrapper {
        color: var(--color-text-1);

        &:hover {
          color: var(--color-text-1);
        }
      }

      .ant-tree-node-selected {
        background: none;
        color: var(--color-text-1);
        font-weight: 500;
      }

      &:hover {
        .more-file-icon {
          .more-file-hover-icon {
            display: inline-flex !important;
          }
        }
      }
    }

    .ant-tree-indent {
      align-self: stretch;
      user-select: none;
    }

    .ant-tree-indent-unit {
      width: 8px;
    }

    .ant-tree-switcher {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 32px;
      margin-inline-end: 4px;
      color: var(--color-text-2);
      line-height: 0;

      &:before {
        display: none;
      }

      &.ant-tree-switcher-leaf {
        width: 0 !important;
        min-width: 0 !important;
        margin-inline-end: 0 !important;
      }
    }

    .ant-tree-switcher-icon {
      font-size: 0;
    }

    .tree-switcher-icon-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 16px;
    }

    .tree-switcher-icon {
      flex-shrink: 0;
      color: var(--color-text-2);
      transform: rotate(-90deg);
      transition: transform 0.2s ease, color 0.15s ease;

      &.tree-switcher-icon--expanded {
        transform: rotate(0deg);
      }
    }

    .ant-tree-node-content-wrapper {
      min-width: 0;
      min-height: 32px;
      padding: 5px 8px 5px 0;
      border-radius: 8px;
      display: flex;
      align-items: center;
      max-width: 100%;

      &:hover {
        background: none;
      }
    }

    .ant-tree-title {
      width: 100%;
      min-width: 0;
    }
  }

  .file-tree-title {
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;

    .file-icon {
      flex-shrink: 0;
      width: 16px;
      height: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 6px;
    }

    .name {
      flex: 1;
      user-select: none;
    }

    .more-file-icon {
      margin-left: 6px;
      width: 20px;
      height: 20px;

      .more-file-hover-icon {
        display: none !important;
        transform: rotate(90deg);
        path {fill: var(--color-text-3);}
      }
    }
  }

  .folder-tree-name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    line-height: 22px;
    color: var(--color-text-1);
    user-select: none;
  }

  .ant-layout-sider-children {
    overflow: visible;
  }


