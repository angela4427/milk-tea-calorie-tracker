    display: flex;
    align-items: center;
    width: 96px;
    height: 28px;
    padding: 0 3px 0 4px;
    border: 0;
    border-radius: 6px;
    background: rgba(87, 104, 161, 0.08);
    box-sizing: border-box;
    appearance: none;
    cursor: pointer;
    transition: background-color 0.15s ease;

    &:hover {
      background: rgba(82, 100, 154, 0.13);
    }
  }

