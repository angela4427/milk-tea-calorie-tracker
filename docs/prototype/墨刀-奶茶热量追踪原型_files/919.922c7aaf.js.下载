    .ant-upload {
      display: block;
      width: 100%;
    }
  }

  .cover-sortable-slot {
    width: 100%;
  }

  .cover-slot-drag-handle {
    width: 100%;
  }

  .cover-slot {
    width: 100%;
    height: 69px;
    border: 1px solid var(--color-border-2);
    border-radius: 8px;
    background: var(--color-fill-nav);
    overflow: hidden;
    padding: 0;
    cursor: pointer;

    &.active {
      border-color: var(--brand-500);
      background: var(--brand-50);
    }

