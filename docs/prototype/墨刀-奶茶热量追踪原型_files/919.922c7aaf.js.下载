    width: 100%;
    height: 96px;
    flex: 0 0 96px;
    padding: 0;
    box-sizing: border-box;
    border: 1px solid var(--color-border-1, #eceef2);
    border-radius: 8px;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
  }

  .ppt-presentation-navigator-preview-item:hover {
    box-shadow:
      0 0 0 1px var(--color-fill-bg, #ffffff),
      0 0 0 3px var(--brand-200, #c2cfff);
  }

  .ppt-presentation-navigator-preview-item.active {
    box-shadow:
      0 0 0 1px var(--color-fill-bg, #ffffff),
      0 0 0 3px var(--brand-500, #6669ff);
  }

  .ppt-presentation-navigator-preview-item .ppt-presentation-thumbnail {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ppt-presentation-page-navigator.preview-open {
      animation: none;
    }

    .ppt-presentation-page-navigator.preview-open.preview-closing {
      opacity: 0;
    }
  }

  .ppt-presentation-preview-scroll {
    flex: 1;
    width: auto;
    min-height: 0;
    padding: 8px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    overflow-y: auto;
    scroll-behavior: smooth;
    min-width: 0;
  }

  .ppt-presentation-preview-main {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .ppt-presentation-inner-header {
    height: 48px;
    padding: 0 16px;
    box-sizing: border-box;
    border-bottom: 1px solid var(--color-border-1);
    background: var(--color-fill-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    z-index: 2;
  }

  .ppt-presentation-inner-header .header-left,
  .ppt-presentation-inner-header .header-right {
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .ppt-presentation-inner-header .ppt-presentation-header-actions {
    flex-shrink: 0;
  }

  .ppt-presentation-inner-header .ppt-presentation-action-tooltip-target {
    display: inline-flex;
  }

  .ppt-presentation-page-section {
    width: min(100%, 1268px);
    min-width: 0;
  }

  .ppt-presentation-page-section.is-ppt-presentation-editing {
    position: relative;
    z-index: 2;
  }

  .ppt-presentation-page-section.is-ppt-presentation-editing
    .ppt-presentation-page-frame,
  .ppt-presentation-page-section.is-ppt-presentation-editing
    .ppt-presentation-page-ratio {
    overflow: visible;
  }

  .ppt-presentation-page-toolbar {
    height: 32px;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .ppt-presentation-page-count {
    color: var(--color-text-2, #555557);
    font-size: 14px;
    line-height: 22px;
    font-weight: 400;
  }

  .ppt-presentation-page-ai-entry {
    position: relative;
    flex-shrink: 0;
  }

  .ppt-presentation-page-ai-btn {
    position: relative;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--color-text-2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .ppt-presentation-page-ai-icon {
    position: relative;
    width: 24px;
    height: 24px;
    padding: 4px;
    box-sizing: border-box;
    display: block;
  }

  .ppt-presentation-page-ai-star {
    position: absolute;
    pointer-events: none;
    will-change: transform;
  }

  .ppt-presentation-page-ai-star-primary {
    left: 0px;
    bottom: -4px;
    transform-origin: center;
  }

  .ppt-presentation-page-ai-star-secondary {
    top: 8px;
    right: 3px;
    transform-origin: center;
  }

  .ppt-presentation-page-ai-btn:hover .ppt-presentation-page-ai-star-primary {
    animation: ppt-presentation-page-ai-star-primary 1.7s linear infinite;
  }

  .ppt-presentation-page-ai-btn:hover .ppt-presentation-page-ai-star-secondary {
    animation: ppt-presentation-page-ai-star-secondary 1.7s linear infinite;
  }

  @keyframes ppt-presentation-page-ai-star-primary {
    0%,
    4% {
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    40% {
      transform: scale(0.57);
      animation-timing-function: ease-out;
    }

    45% {
      transform: scale(0.62);
      animation-timing-function: ease-out;
    }

    50%,
    54% {
      transform: scale(0.6);
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    90% {
      transform: scale(1.03);
      animation-timing-function: ease-out;
    }

    95% {
      transform: scale(0.985);
      animation-timing-function: ease-out;
    }

    100% {
      transform: scale(1);
    }
  }

  @keyframes ppt-presentation-page-ai-star-secondary {
    0%,
    4% {
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    40% {
      transform: scale(1.46);
      animation-timing-function: ease-out;
    }

    45% {
      transform: scale(1.37);
      animation-timing-function: ease-out;
    }

    50%,
    54% {
      transform: scale(1.4);
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    90% {
      transform: scale(0.94);
      animation-timing-function: ease-out;
    }

    95% {
      transform: scale(1.03);
      animation-timing-function: ease-out;
    }

    100% {
      transform: scale(1);
    }
  }

  .ppt-presentation-page-ai-popover-wrap .ant-popover-inner {
    padding: 0;
    border-radius: 12px;
    background: transparent;
    box-shadow: none;
  }

  .ppt-presentation-page-ai-popover {
    width: 356px;
    height: 43px;
    padding: 6px 10px 6px 12px;
    box-sizing: border-box;
    border: 1px solid var(--color-border-1, #eceef2);
    border-radius: 12px;
    background: #fff;
    box-shadow:
      var(--Shadow-2downdrop2x, 0) var(--Shadow-2downdrop2y, 4px)
        var(--Shadow-2downdrop2Blur, 20px) var(--Shadow-2downdrop2Spread, 0)
        var(--Shadow-2downdrop2Color, rgba(0, 0, 0, 0.04)),
      var(--Shadow-2downdrop1x, 0) var(--Shadow-2downdrop1y, 3px)
        var(--Shadow-2downdrop1Blur, 12px) var(--Shadow-2downdrop1Spread, 0)
        var(--Shadow-2downdrop1Color, rgba(0, 0, 0, 0.02));
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ppt-presentation-page-ai-textarea {
    flex: 1;
    min-width: 0;
    /* height: 32px; */
    padding: 6px 0;
    border: 0;
    outline: 0;
    resize: none;
    overflow: hidden;
    background: transparent;
    color: var(--color-text-1);
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
    caret-color: var(--brand-600);
    margin-right: 6px;
  }

  .ppt-presentation-page-ai-textarea::placeholder {
    color: var(--color-text-4);
  }

  .ppt-presentation-page-ai-submit {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .ppt-presentation-page-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    box-sizing: border-box;
    border: 1px solid var(--color-border-1, #eceef2);
    border-radius: 18px;
    background: var(--color-fill-bg);
    overflow: hidden;
  }

  .ppt-presentation-page-ratio {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ppt-presentation-page-ratio .loading-box {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .ppt-presentation-page-iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--color-fill-bg);
  }

  .ppt-presentation-page-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--color-fill-bg);
  }

  .ppt-presentation-page-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-3);
    font-size: 13px;
    background: var(--color-fill-bg);
  }

  .ppt-presentation-empty {
    width: 100%;
    height: 100%;
    background: var(--color-fill-bg);
  }

  &.compact-ppt-presentation-preview {
    flex: 1;
    min-height: 0;
    background: transparent;
    display: flex;
    flex-direction: column;

    .ppt-presentation-preview-scroll {
      width: 100%;
      flex: 1;
      min-height: 0;
      padding: 8px 20px;
      gap: 16px;
      -webkit-overflow-scrolling: touch;
    }

    .ppt-presentation-page-toolbar {
      height: 22px;
      margin-bottom: 4px;
    }

    .ppt-presentation-page-count {
      font-size: 12px;
      line-height: 22px;
      font-weight: 400;
    }

    .ppt-presentation-page-iframe {
      /* 移动端 PPT 页以预览滚动为主，iframe 接管触摸事件会导致外层滚动容器无法滚动。 */
      pointer-events: none;
    }

    .ppt-presentation-page-section {
      width: 100%;
    }

    .ppt-presentation-page-frame {
      border: 1px solid var(--color-border-1, #eceef2);
      border-radius: 16px;
    }
  }
