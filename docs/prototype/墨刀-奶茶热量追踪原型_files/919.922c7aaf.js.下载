  .ppt-presentation-play-stage {
    width: 100%;
    height: 100%;
    padding: 0 24px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ppt-presentation-play-frame {
    width: min(calc(100vw - 48px), calc((100vh) * 16 / 9));
    max-width: 100%;
    aspect-ratio: 16 / 9;
    background: #ffffff;
    position: relative;
    overflow: hidden;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.36);
  }

  .ppt-presentation-play-iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    background: #ffffff;
  }

  .ppt-presentation-play-svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    background: #ffffff;
  }

  .ppt-presentation-play-click-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .ppt-presentation-play-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    position: absolute;
    left: 50%;
    bottom: 12px;
    z-index: 5;
    transform: translate(-50%, 16px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.16s ease,
      transform 0.16s ease;
  }

  &.toolbar-visible .ppt-presentation-play-toolbar {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .ppt-presentation-play-toolbar-panel {
    padding: 5px 6px;
    box-sizing: border-box;
    border: 1px solid #ffffff14;
    border-radius: 12px;
    background: #212121;
    box-shadow:
