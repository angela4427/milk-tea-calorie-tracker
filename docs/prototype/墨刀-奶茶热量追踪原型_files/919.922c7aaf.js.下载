    min-width: 0;
    width: auto;
    max-width: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-text-1);

    &::selection {
      background: var(--brand-200);
      color: var(--color-text-1);
    }
  }

  .link-suffix {
    flex-shrink: 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-text-3);
  }

  .link-action-btn {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-2);
    transition: background-color 0.16s ease, color 0.16s ease;

    &:hover {
      background: var(--color-fill-nav);
      color: var(--color-text-1);
    }

    &:active {
      background: var(--color-fill-hov);
    }

    &.is-loading {
      color: var(--brand-400);
    }

    &.is-success {
      color: var(--brand-500);
    }

