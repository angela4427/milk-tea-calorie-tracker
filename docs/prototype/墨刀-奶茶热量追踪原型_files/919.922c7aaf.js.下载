      }
    }
  }

  .slug-text,
  .slug-editor-wrap,
  .link-anchor {
    min-width: 0;
    flex: 0 1 auto;
    border-bottom: 1px solid transparent;
  }

  .link-anchor {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .slug-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-text-1);
  }

  .slug-editor-wrap {
    display: inline-flex;
    align-items: center;
  }

