                background-color: var(--color-bg-card);
              }
            }

            svg {
              color: var(--color-text-1);
            }
          }
        }
      }
    }

    .content-right {
      width: 298px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;

      .case-info {
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding: 32px 24px;
        border-radius: 12px;
        border: 1px solid var(--color-bg-border-01);
        background: var(--color-fill-bg);

        .case-title {
          font-size: 20px;
          font-weight: 600;
          line-height: 28px;
          color: var(--color-text-1);
          margin: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;
          max-height: 56px;
        }

        .case-stats {
          display: flex;
          align-items: center;
          line-height: 1;
          margin: 0;
          gap: 4px;

          .stat-icon {
            path {
              fill: var(--color-success);
            }
          }

          .stat-value {
            font-weight: 400;
            color: var(--color-text-3);
            font-size: 12px;

            .stat-value-text {
              font-weight: 500;
              font-size: 12px;
              color: var(--color-text-1);
            }
          }
        }
      }

      .case-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: auto;

        .action-btn {
          width: 100%;
          height: 40px;
          display: flex;
          align-items: center;
          line-height: 1;
          font-weight: 500;

          &.ant-btn-primary {
            border-radius: 8px;
            color: white;
            background-color: rgba(38, 111, 255, 1);

            svg path {
              fill: white;
            }

            &:hover {
              background: var(--color-btn-primary-hover);
            }

            &:active {
              background: var(--color-btn-primary-cliicked);
            }

            &:disabled {
              background: var(--color-btn-primary-disabled);
              border-color: var(--color-btn-primary-disabled);
              cursor: not-allowed;
            }
          }

          &.ant-btn-default {
            border-radius: 8px;

            &:disabled {
              background: white;
              color: var(--color-btn-primary-disabled);
              border: 1.5px solid var(--color-btn-primary-disabled);
              cursor: not-allowed;
            }
          }

          &.offline-btn {
            background: rgb(204, 204, 204) !important;
            color: rgb(255, 255, 255) !important;
            font-weight: 600;
            border: 1px solid var(--color-border-3) !important;
            cursor: not-allowed;
            opacity: 1;
          }


          &.playback-btn {
            background: var(--color-fill-bg);
            border: 1.5px solid var(--color-btn-primary-normal);
            color: var(--color-btn-primary-normal);

            &:hover {
              background: var(--color-bg-select-3);
              border-color: var(--color-btn-primary-normal);
            }

            &:active {
              background: var(--color-bg-tab);
              border-color: var(--color-btn-primary-normal);
            }
          }
        }
      }
    }

    .author-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 20px 24px;
      border-radius: 12px;
      border: 1px solid var(--color-bg-border-01);
      background: var(--color-fill-bg);

      .author-header {
        display: flex;
        align-items: center;
        gap: 12px;

        .author-avatar-wrapper {
          position: relative;
          width: 32px;
          height: 32px;
          overflow: hidden;

          .author-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
          }

        }

        .author-details {
          display: flex;
          flex-direction: column;
          width: 198px;
          gap: 2px;

          .author-name {
            font-size: 14px;
            font-weight: 500;
            line-height: 20px;
            color: rgba(31, 41, 46, 1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          }

          .author-works {
            font-weight: 400;
            font-size: 12px;
            line-height: 20px;
            color: var(--color-text-3);
          }
        }
      }


    }
  }
  
  .reuse-target-modal {
    .ant-modal-content {
      padding: 0;
      border-radius: 16px;
      border: 1px solid var(--color-border-1);
      box-shadow:
        0 20px 24px -4px rgba(10, 13, 18, 0.08),
        0 8px 8px -4px rgba(10, 13, 18, 0.03);
      overflow: hidden;
    }

    .ant-modal-header {
      margin: 0;
      padding: 24px 18px 0 24px;
      border-bottom: none;
    }

    .ant-modal-title {
      height: 24px;
      line-height: 22px;
      font-size: 16px;
      font-weight: 500;
      color: var(--color-text-1);
    }

    .ant-modal-close {
      top: 20px;
      inset-inline-end: 12px;
    }

    .ant-modal-body {
      padding: 20px 24px;
    }

    .ant-modal-footer {
      margin: 0;
      padding: 0 24px 24px;
      border-top: none;
    }
  }

  .reuse-target-modal-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .reuse-target-modal-org-select {
    width: fit-content;
    display: flex;
    align-items: center;
    height: 22px;

    .ant-select-selector {
      border: none !important;
      box-shadow: none !important;
      background: transparent !important;
      padding: 0 !important;
      min-height: 20px !important;
      height: 20px !important;
      display: flex;
      align-items: center;
      gap: 2px;

      .ant-select-selection-wrap {
        /* max-width: 72px; */
      }

      .ant-select-prefix {
        width: 20px;
        height: 20px;
        margin-left: 12px;
        margin-right: 4px;
      }
    }

    .ant-select-arrow {
      position: unset;
      width: 20px;
      height: 20px;
      margin-top: 0;
      pointer-events: auto !important;
    }

    .ant-select-selection-item {
      font-size: 12px;
      font-weight: 500;
      color: var(--color-text-1);
      line-height: 20px;
      padding-inline-end: 0;
    }
  }

  .reuse-target-modal-arrow {
    font-size: 10px;
    color: var(--color-text-2);
    line-height: 1;
  }

  .reuse-target-modal-org-suffix {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .reuse-target-modal-org-dropdown {
    width: 234px !important;
    padding: 8px 0 8px 8px !important;
    border-radius: 8px !important;
    border: 1px solid var(--color-border-1) !important;
    box-shadow: 0px 4px 10px 0px rgba(0, 18, 38, 0.1) !important;
    background: #ffffff !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;

    .ant-select-item {
      padding: 5px 12px 5px 8px !important;
      font-size: 12px !important;
      font-weight: 500 !important;
      line-height: 22px !important;
      color: var(--color-text-1) !important;

      .reuse-target-modal-org-option-checked {
        width: 16px;
        height: 16px;
        svg {
          width: 100%;
          height: 100%;
        }
      }
    }
    /* split-line item */
    .ant-select-item[title="split-line"] {
      padding: 0 !important;
      margin: 8px 0 !important;
      height: 1px !important;
      min-height: 1px !important;
      background: var(--color-border-1) !important;
      cursor: default !important;
    }

    .ant-select-item-option-selected:not(.ant-select-item-option-disabled) {
      background: var(--color-btn-secondary-hover) !important;
    }
  }

  .reuse-target-modal-space-list {
    height: 186px;
    overflow: auto;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 2px;
    padding-right: 2px;
    scrollbar-width: 1px;
    scrollbar-color: var(--color-slider-normal) transparent;

    .reuse-target-modal-empty {
      height: 100%;
      justify-self: center;
    }
  }

  .reuse-target-modal-space-list::-webkit-scrollbar {
    width: 6px;
  }

  .reuse-target-modal-space-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .reuse-target-modal-space-list::-webkit-scrollbar-thumb {
    background: var(--color-slider-normal);
    border-radius: 999px;
    border: 1px solid transparent;
    background-clip: padding-box;
  }

  .reuse-target-modal-space-list::-webkit-scrollbar-thumb:hover {
    background: var(--color-slider-normal);
  }

  .reuse-target-modal-space-item {
    width: 100%;
    height: 32px;
    border: none;
    border-radius: 6px;
    background: transparent;
    padding: 5px 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    text-align: left;

    &:hover {
      background: rgba(87, 104, 161, 0.08);
    }

    &.active {
      background: var(--color-bg-select-3);

      svg path {
        fill: var(--brand-500);
      }
    }
  }

  .reuse-target-modal-space-icon {
    width: 20px;
    height: 20px;
  }

  .reuse-target-modal-space-name {
    font-size: 12px;
    line-height: 20px;
    color: var(--color-text-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reuse-target-modal-empty {
    height: 48px;
    display: flex;
    align-items: center;
    color: var(--color-text-3);
    font-size: 12px;
  }

  .reuse-target-modal-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
  }

  .reuse-target-modal-btn {
    border-radius: 8px;
    height: 38px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
  }

  .reuse-target-modal-btn-cancel {
    border: 1px solid var(--color-border-2);
    background: var(--color-fill-bg);
    color: var(--color-text-1);
  }

  .reuse-target-modal-btn-confirm.ant-btn-primary {
    border: 1px solid #6669ff;
    background: #6669ff;
    color: #fff;

    &:hover {
      border-color: #6669ff;
      background: #6669ff;
      opacity: 0.95;
    }

    &:disabled {
      border-color: var(--color-border-2);
      background: var(--color-fill-hov);
      color: var(--color-text-4);
      opacity: 0.4;
    }
  }
