      display: flex;
      align-items: center;
      justify-content: center;
      border-style: dashed;
      color: var(--color-text-3);
      font-size: 24px;
      line-height: 1;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

