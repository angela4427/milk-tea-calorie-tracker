    margin-left: 1px;
    font-size: 12px;
    font-weight: 500;
    line-height: 17px;
    letter-spacing: 0;
    background: linear-gradient(271.57deg, #FB5FFF -32.21%, #4136F5 87.76%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    white-space: nowrap;
  }

  .survey-feedback-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-left: 0;

    svg {
      flex: 0 0 auto;
      transform: rotate(-90deg);

      path {
        fill: rgba(189, 81, 252, 1);
      }
    }
  }

  .survey-feedback-btn:hover .survey-feedback-arrow {
    animation: surveyFeedbackArrowMove 2.5s ease-in-out;
  }

  @keyframes surveyFeedbackArrowMove {
    0%,
    33.333%,
    66.666%,
    100% {
      transform: translateX(0);
    }

    16.666%,
    50%,
    83.333% {
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .survey-feedback-btn:hover .survey-feedback-arrow {
      animation: none;
    }
  }
