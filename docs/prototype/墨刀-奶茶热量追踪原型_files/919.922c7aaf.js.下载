    padding: 6px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    color: #ffffffe8;
    display: inline-flex;
    align-items: center;
    text-align: center;
    white-space: nowrap;
  }

  .ppt-presentation-play-page-number {
    min-width: 26px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ppt-presentation-play-page-separator {
    height: 20px;
    display: inline-flex;
    align-items: center;
  }

  .ppt-presentation-play-empty {
    width: 100%;
    height: 100%;
    background: #ffffff;
  }
