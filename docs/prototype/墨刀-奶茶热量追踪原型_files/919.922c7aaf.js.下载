        var(--Shadow-2downdrop1Spread, 0)
        var(--Shadow-2downdrop1Color, rgba(0, 0, 0, 0.02));
    display: flex;
    align-items: center;
  }

  .ppt-presentation-play-control-btn {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #ffffffe8;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .ppt-presentation-play-control-btn svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .ppt-presentation-play-control-btn svg * {
    fill: currentColor;
  }

  .ppt-presentation-play-control-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .ppt-presentation-play-control-btn:disabled {
    color: rgba(255, 255, 255, 0.32);
    cursor: not-allowed;
  }

  .ppt-presentation-play-control-btn.next svg {
    transform: rotate(180deg);
  }

  .ppt-presentation-play-divider {
    width: 0;
    height: 20px;
    margin: 0 6px;
    border-left: 1px solid #333333;
    flex-shrink: 0;
  }

