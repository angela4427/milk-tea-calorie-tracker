    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: var(--color-fill-hov);
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    color: var(--color-fill-svg);
    padding: 4px;

    svg path {
      fill: currentColor;
    }

    svg [stroke] {
      stroke: currentColor;
    }

    &:hover {
      background: var(--color-fill-clk);

      &:not(.active) svg path {
        fill: currentColor;
      }

      &:not(.active) svg [stroke] {
        stroke: currentColor;
      }
    }

    &:active {
      background: var(--color-fill-clk);
    }

    &.active {
      color: var(--brand-500);
      svg path {
        fill: var(--brand-500);
      }

      svg [stroke] {
        stroke: var(--brand-500);
      }
    }
  }

